# Postgres container init (used by docker-compose for the `database` service)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Local app connection string, used by `next dev` running on the host.
# Copy into .env.local, not .env.
# - `next dev` on the host -> localhost
# - Vercel (vercel env pull .env.local) -> whatever is configured in the
#   project's environment variables (e.g. a Neon connection string)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DB_NAME"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@localhost:5432/DB_NAME"

# Container connection string, used by docker-compose for the `app` service.
# Copy into .env.docker-compose. Host is the `database` service name, not
# localhost, since the app reaches postgres over the compose network.
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=
# DATABASE_URL="postgresql://USER:PASSWORD@database:5432/DB_NAME"
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@database:5432/DB_NAME"
